      "durationSeconds": 20.208,
      "cues": [
        {
          "start": 0.1,
          "end": 5.687,
          "text": "A vision encoder extracts image features, and connections to language support answers."
        },
        {
          "start": 5.637,
          "end": 14.743,
          "text": "At fixed image dimensions in a simple patch model, smaller patches mean more patches and often more computation, not guaranteed accuracy."
        },
        {
          "start": 14.743,
          "end": 20.147,
          "text": "Users can provide clear crops or use detail settings the tool actually supports."
        }
      ]
    },
    {
      "id": "takeaway",
