  "W4-Safety-ZH": [
    {
      "id": "hook",
      "audio": "video/core/W4-Safety-ZH/scene-01-hook.mp3",
      "durationSeconds": 16.8,
      "cues": [
        {
          "start": 0.1,
          "end": 7.574,
          "text": "只开放当前任务需要且获准的工具，只保存经同意的必要信息，并写明用途与期限。"
        },
        {
          "start": 7.524,
          "end": 16.738,
          "text": "信息到期就应立即停止检索使用，存储清理另按策略执行并核对结果；记录还在不等于仍可使用。"
        }
      ]
    },
