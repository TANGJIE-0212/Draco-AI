        {
          "start": 0.1,
          "end": 4.008,
          "text": "Plan beginning, middle, and ending states for a shot."
        },
        {
          "start": 3.958,
          "end": 8.591,
          "text": "This is a production method, not every video model’s internal algorithm."
        },
        {
          "start": 8.591,
          "end": 12.708,
          "text": "Inspect characters, props, and action continuity."
        },
        {
          "start": 12.708,
          "end": 19.056,
          "text": "Listen to original narration before checking captions, distinguishing speech and transcription errors."
        },
        {
          "start": 19.056,
          "end": 24.424,
