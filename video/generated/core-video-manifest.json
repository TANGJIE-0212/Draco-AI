      "audio": "video/core/W3-Vision-ZH/scene-03-takeaway.mp3",
      "durationSeconds": 14.16,
      "cues": [
        {
          "start": 0.1,
          "end": 9.167,
          "text": "模型能做光学字符识别、识别物体和空间关系，也会在画面模糊、裁切或遮挡时根据常识脑补。"
        },
        {
          "start": 9.167,
          "end": 14.107,
          "text": "使用视觉模型时，要把可见证据和模型推断分开。"
        }
      ]
    }
  ],
