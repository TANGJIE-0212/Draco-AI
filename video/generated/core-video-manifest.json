        {
          "start": 0.1,
          "end": 7.195,
          "text": "When offered, Seed controls the random start, Steps the denoising iterations, and CFG the guidance strength."
        },
        {
          "start": 7.145,
          "end": 10.564,
          "text": "A new seed can change composition and identity."
        },
        {
          "start": 10.564,
          "end": 15.049,
          "text": "Matching a seed also requires matching the model and other settings."
        },
        {
          "start": 15.049,
