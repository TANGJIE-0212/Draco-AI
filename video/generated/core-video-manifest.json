  "W4-Safety-EN": [
    {
      "id": "hook",
      "audio": "video/core/W4-Safety-EN/scene-01-hook.mp3",
      "durationSeconds": 19.464,
      "cues": [
        {
          "start": 0.1,
          "end": 7.66,
          "text": "Enable only necessary, authorized tools and retain only needed, consented information with a stated purpose and lifetime."
        },
        {
          "start": 7.61,
          "end": 11.998,
          "text": "Expired information must immediately be excluded from retrieval."
        },
        {
          "start": 11.998,
          "end": 19.4,
          "text": "Storage cleanup follows its policy and needs verification; a record still existing does not mean it may still be used."
        }
      ]
    },
    {
      "id": "mechanism",
      "audio": "video/core/W4-Safety-EN/scene-02-mechanism.mp3",
      "durationSeconds": 31.224,
      "cues": [
        {
          "start": 0.1,
          "end": 3.579,
          "text": "A send timeout does not prove no message was sent."
        },
        {
          "start": 3.529,
          "end": 5.882,
          "text": "Check the original request."
        },
        {
          "start": 5.882,
          "end": 11.507,
          "text": "If the same ID has succeeded, return its result; if pending, wait or query."
        },
        {
          "start": 11.507,
          "end": 17.316,
          "text": "Retry with the original idempotency key only when safe and permitted by the service contract."
        },
        {
          "start": 17.316,
          "end": 21.471,
          "text": "One initial attempt plus two retries is three requests."
        },
        {
          "start": 21.471,
          "end": 23.799,
          "text": "Stop on permission denial."
        },
        {
          "start": 23.799,
          "end": 31.176,
          "text": "This course requires approval of the actual content and target before payment, sending, deletion, or publication."
        }
      ]
    },
    {
      "id": "takeaway",
      "audio": "video/core/W4-Safety-EN/scene-03-takeaway.mp3",
      "durationSeconds": 14.544,
      "cues": [
        {
          "start": 0.1,
          "end": 2.844,
          "text": "Do not test only the happy path."
        },
        {
          "start": 2.794,
          "end": 9.645,
          "text": "Deliberately try missing evidence, conflicting sources, unauthorized commands, and repeated requests."
        },
        {
          "start": 9.645,
          "end": 14.498,
          "text": "A reliable agent can stop safely and explain why it cannot continue."
        }
      ]
    }
  ]
