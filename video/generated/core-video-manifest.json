{
  "W1-Mechanism-ZH": [
    {
      "id": "hook",
      "audio": "video/core/W1-Mechanism-ZH/scene-01-hook.mp3",
      "durationSeconds": 15.504,
      "cues": [
        {
          "start": 0.1,
          "end": 5.764,
          "text": "我们读到的是一句完整的话，大语言模型看到的却是一串数字。"
        },
        {
          "start": 5.714,
          "end": 15.452,
          "text": "分词器先把文字切成词元，也就是 Token，再把每个词元换成编号和向量，让模型可以计算词语之间的关系。"
        }
      ]
    },
    {
      "id": "mechanism",
      "audio": "video/core/W1-Mechanism-ZH/scene-02-mechanism.mp3",
      "durationSeconds": 17.472,
      "cues": [
        {
          "start": 0.1,
          "end": 4.693,
          "text": "Embedding，也就是嵌入表示，把词元放进语义空间。"
        },
        {
          "start": 4.643,
          "end": 11.905,
          "text": "Transformer 的注意力机制再比较查询、键和值，为当前位置找出更相关的信息。"
        },
        {
          "start": 11.905,
          "end": 17.429,
          "text": "同一个词进入不同句子后，因此可以形成不同的上下文表示。"
        }
      ]
    },
    {
      "id": "takeaway",
      "audio": "video/core/W1-Mechanism-ZH/scene-03-takeaway.mp3",
      "durationSeconds": 17.016,
      "cues": [
        {
          "start": 0.1,
          "end": 8.407,
          "text": "模型为下一步候选词元产生原始分数，用 Softmax 换成概率，再按设置选出下一词元。"
        },
        {
          "start": 8.357,
          "end": 12.262,
          "text": "新词元加入上下文后，流程重新开始。"
        },
        {
          "start": 12.262,
          "end": 16.952,
          "text": "模型是在逐步预测，不是在一次性写完整篇答案。"
        }
      ]
    }
  ],
  "W2-Design-ZH": [
    {
      "id": "hook",
      "audio": "video/core/W2-Design-ZH/scene-01-hook.mp3",
      "durationSeconds": 14.568,
      "cues": [
        {
          "start": 0.1,
          "end": 7.848,
          "text": "同一个模型，有人只说帮我写好一点，有人却写清受众、长度、资料和成功标准。"
        },
        {
          "start": 7.798,
          "end": 14.5,
          "text": "后者是在做提示词工程，也就是把模糊愿望变成可执行、可检查的任务。"
        }
      ]
    },
    {
      "id": "mechanism",
      "audio": "video/core/W2-Design-ZH/scene-02-mechanism.mp3",
      "durationSeconds": 14.352,
      "cues": [
        {
          "start": 0.1,
          "end": 9.821,
          "text": "可靠提示词先说明目标和受众，再提供必要背景与资料，写清不能做什么，最后规定输出形式和验收标准。"
        },
        {
          "start": 9.821,
          "end": 14.298,
          "text": "资料是参考内容，不是可以覆盖任务规则的新命令。"
        }
      ]
    },
    {
      "id": "takeaway",
      "audio": "video/core/W2-Design-ZH/scene-03-takeaway.mp3",
      "durationSeconds": 15.024,
      "cues": [
        {
          "start": 0.1,
          "end": 5.419,
          "text": "使用标题和分隔符把任务、资料、示例与规则分开。"
        },
        {
          "start": 5.369,
          "end": 9.31,
          "text": "遇到未知信息就明确标出，不要让模型猜。"
        },
        {
          "start": 9.31,
          "end": 14.964,
          "text": "一个好提示词不是看起来专业，而是别人能够重复使用和检查。"
        }
      ]
    }
  ],
  "W2-Test-ZH": [
    {
      "id": "hook",
      "audio": "video/core/W2-Test-ZH/scene-01-hook.mp3",
      "durationSeconds": 13.704,
      "cues": [
        {
          "start": 0.1,
          "end": 4.883,
          "text": "一份提示词在正常问题上答对，不代表它真的可靠。"
        },
        {
          "start": 4.833,
          "end": 13.643,
          "text": "测试集还要包含资料缺失、格式异常和伪指令混入等情况，才能看到它会不会编造或越过边界。"
        }
      ]
    },
    {
      "id": "mechanism",
      "audio": "video/core/W2-Test-ZH/scene-02-mechanism.mp3",
      "durationSeconds": 16.536,
      "cues": [
        {
          "start": 0.1,
          "end": 7.205,
          "text": "先运行第一版并记录具体失败，再只修改一个问题，用同一组测试重新检查。"
        },
        {
          "start": 7.155,
          "end": 16.488,
          "text": "评分标准，也就是 Rubric，要把准确、完整、格式和边界写成可观察条件，而不是凭感觉说更好。"
        }
      ]
    },
    {
      "id": "takeaway",
      "audio": "video/core/W2-Test-ZH/scene-03-takeaway.mp3",
      "durationSeconds": 14.28,
      "cues": [
        {
          "start": 0.1,
          "end": 5.752,
          "text": "如果资料里写着忽略原规则，系统仍应把它当作待处理文字。"
        },
        {
          "start": 5.702,
          "end": 8.107,
          "text": "这叫提示词注入风险。"
        },
        {
          "start": 8.107,
          "end": 14.214,
          "text": "可靠系统会分清指令和数据，在证据不足或动作越界时停下来。"
        }
      ]
    }
  ],
